{
  "name": "isswf",
  "description": "Local Claude Code entry points for shared isSWF factory methodology",
  "version": "1.9.0",
  "skills": ["./skills/isswf-coordinator", "./skills/isswf-setup", "./skills/isswf-writing", "./skills/isswf-understanding", "./skills/isswf-pr", "./skills/isswf-issue", "./skills/isswf-e2e", "./skills/isswf-debug", "./skills/isswf-review", "./skills/isswf-retrospective", "./skills/isswf-tdd", "./skills/isswf-security", "./skills/isswf-performance", "./skills/isswf-observability", "./skills/isswf-triage", "./skills/isswf-interview", "./skills/isswf-howto"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "initiativesPane": {
      "type": "boolean",
      "title": "Initiatives pane",
      "description": "Show the isSWF initiatives pane once the isswf-coordinator skill loads. Off: the pane does no reads, timers, commands or UI.",
      "default": false
    }
  },
  "mcpServers": {
    "isswf_git_evidence": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/tools/git-evidence-mcp.mjs"
      ],
      "env": {
        "ISSWF_GIT_EVIDENCE_BINDINGS": "${ISSWF_GIT_EVIDENCE_BINDINGS}"
      }
    }
  }
}
